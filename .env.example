# Values for `docker compose`. Copy to .env (git-ignored) and fill in. Never commit .env.

# Local database password. Avoid @ : / ? # % (it is placed inside a database URL).
POSTGRES_PASSWORD=change-me-local-db-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Browser origins allowed to call the API (Expo web dev server by default)
CORS_ORIGINS=http://localhost:8081
