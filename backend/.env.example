# Copy to .env for local development. Never commit .env.
APP_ENV=development

# SQLAlchemy URL (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://momali:change-me@localhost:5432/momali

# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start in production while this placeholder is set.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Comma-separated browser origins allowed to call the API (Expo web dev server by default)
CORS_ORIGINS=http://localhost:8081

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOG_LEVEL=INFO
